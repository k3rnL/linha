{
  "uid": "linha-operations",
  "title": "Linha · Queries and capacity",
  "description": "Query activity, outcomes, processing time and the capacity serving your requests. Expand Diagnostics for internal health checks.",
  "tags": [
    "linha",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 2,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(linha_server_build_info,cluster)",
        "definition": "label_values(linha_server_build_info,cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(linha_server_build_info{cluster=~\"$cluster\"},namespace)",
        "definition": "label_values(linha_server_build_info{cluster=~\"$cluster\"},namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "linha_deployment",
        "label": "Deployment",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(linha_server_build_info{cluster=~\"$cluster\",namespace=~\"$namespace\"},linha_deployment)",
        "definition": "label_values(linha_server_build_info{cluster=~\"$cluster\",namespace=~\"$namespace\"},linha_deployment)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "engine",
        "label": "Engine",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(linha_context_versions{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\"},engine)",
        "definition": "label_values(linha_context_versions{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\"},engine)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "context",
        "label": "Context",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(linha_context_versions{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\"},context)",
        "definition": "label_values(linha_context_versions{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\"},context)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Server pod (diagnostics)",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(linha_server_build_info{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\"},pod)",
        "definition": "label_values(linha_server_build_info{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\"},pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "uiBaseUrl",
        "type": "constant",
        "query": "",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Queries",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running now",
      "description": "Requests currently executing. Cancelling requests are shown separately in the activity chart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (max by (cluster,namespace,linha_deployment,engine,context,state) (linha_job_records{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",state=\"RUNNING\"}))",
          "legendFormat": "Running now",
          "interval": "15s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queued now",
      "description": "Accepted requests waiting to execute, including those waiting before a retry.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (max by (cluster,namespace,linha_deployment,engine,context,state) (linha_job_records{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",state=~\"QUEUED|RETRYING\"}))",
          "legendFormat": "Queued now",
          "interval": "15s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Succeeded · selected period",
      "description": "Successful requests during the dashboard time range. Estimated from Prometheus samples; retries are not extra requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=\"SUCCEEDED\"}))[$__range:15s]))",
          "legendFormat": "Succeeded · selected period",
          "interval": "15s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Failed · selected period",
      "description": "Final request failures during the dashboard time range, after any allowed retries. Open Requests in the console for exceptions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=\"FAILED\"}))[$__range:15s]))",
          "legendFormat": "Failed · selected period",
          "interval": "15s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Success rate · selected period",
      "description": "Succeeded / (succeeded + failed) during the selected period. Cancelled requests are excluded. No completed requests means no percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (increase((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=\"SUCCEEDED\"}))[$__range:15s])) / sum (increase((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=~\"SUCCEEDED|FAILED\"}))[$__range:15s]))",
          "legendFormat": "Success rate · selected period",
          "interval": "15s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Ready servers",
      "description": "Servers with a recent ready heartbeat. Deployment-wide: engine/context filters do not apply.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (max by (cluster,namespace,linha_deployment,state) (linha_servers{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",state=\"ready\"}))",
          "legendFormat": "Ready servers",
          "interval": "15s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query activity",
      "description": "How many requests are running, waiting, or being cancelled at each moment.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (max by (cluster,namespace,linha_deployment,engine,context,state) (linha_job_records{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",state=~\"RUNNING\"}))",
          "legendFormat": "Running",
          "interval": "15s",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum (max by (cluster,namespace,linha_deployment,engine,context,state) (linha_job_records{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",state=~\"QUEUED|RETRYING\"}))",
          "legendFormat": "Queued",
          "interval": "15s",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum (max by (cluster,namespace,linha_deployment,engine,context,state) (linha_job_records{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",state=~\"CANCELLING\"}))",
          "legendFormat": "Cancelling",
          "interval": "15s",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Completions per minute",
      "description": "Request outcomes per minute. Counts each request once, even when execution needed retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum (rate((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=\"SUCCEEDED\"}))[$__rate_interval:15s]))",
          "legendFormat": "Succeeded",
          "interval": "15s",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "60 * sum (rate((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=\"FAILED\"}))[$__rate_interval:15s]))",
          "legendFormat": "Failed",
          "interval": "15s",
          "instant": false
        },
        {
          "refId": "C",
          "expr": "60 * sum (rate((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_completions_total{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\",outcome=\"CANCELLED\"}))[$__rate_interval:15s]))",
          "legendFormat": "Cancelled",
          "interval": "15s",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Time spent waiting and processing",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Processing time",
      "description": "Time from assignment to a finished execution. Queue wait is excluded; retries count as separate executions. The 95% line highlights slower work.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate((max by (cluster,namespace,linha_deployment,engine,context) (linha_attempt_duration_seconds_sum{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s])) / sum (rate((max by (cluster,namespace,linha_deployment,engine,context) (linha_attempt_duration_seconds_count{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s]))",
          "legendFormat": "Average",
          "interval": "15s",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate((max by (cluster,namespace,linha_deployment,engine,context,le) (linha_attempt_duration_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s])))",
          "legendFormat": "95% finish within",
          "interval": "15s",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Queue waiting time",
      "description": "Submission to first assignment for requests that started. A growing queue wait usually means demand exceeds available execution capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate((max by (cluster,namespace,linha_deployment,engine,context,le) (linha_job_queue_wait_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s])))",
          "legendFormat": "Typical (median)",
          "interval": "15s",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate((max by (cluster,namespace,linha_deployment,engine,context,le) (linha_job_queue_wait_seconds_bucket{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s])))",
          "legendFormat": "95% assigned within",
          "interval": "15s",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Not available",
          "links": [],
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "End-to-end request time",
      "description": "Submission to a final outcome, including queue wait, retries and processing. Includes succeeded, failed and cancelled requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_duration_seconds_sum{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s])) / sum (rate((max by (cluster,namespace,linha_deployment,engine,context,outcome) (linha_job_duration_seconds_count{cluster=~\"$cluster\",namespace=~\"$namespace\",linha_deployment=~\"$linha_deployment\",engine=~\"$engine\",context=~\"$context\"}))[$__rate_interval:15s]))",
