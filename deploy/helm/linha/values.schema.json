{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "security": {
      "type": "object",
      "required": [
        "enabled",
        "oidc"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "oidc": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuer": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "insecureSkipVerify": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "viewer": {
              "type": "object",
              "properties": {
                "subjects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "subject"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "issuer": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "values"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "issuer": {
                        "type": "string"
                      },
                      "path": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "values": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            },
            "operator": {
              "type": "object",
              "properties": {
                "subjects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "subject"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "issuer": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "values"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "issuer": {
                        "type": "string"
                      },
                      "path": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "values": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "required": [
        "namespaceOnly"
      ],
      "properties": {
        "namespaceOnly": {
          "type": "boolean"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "postgres"
      ],
      "properties": {
        "postgres": {
          "type": "object",
          "required": [
            "host",
            "port",
            "database",
            "secretRef",
            "usernameKey",
            "passwordKey",
            "sslMode"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "secretRef": {
              "type": "string",
              "minLength": 1
            },
            "usernameKey": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sslMode": {
              "enum": [
                "disable",
                "allow",
                "prefer",
                "require",
                "verify-ca",
                "verify-full"
              ]
            },
            "sslRootCert": {
              "type": "string"
            }
          }
        }
      }
    },
    "workerPodTemplates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driverPodTemplate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "spec": {
              "type": "object"
            }
          }
        },
        "executorPodTemplate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metadata": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "spec": {
              "type": "object"
            }
          }
        }
      }
    },
    "registrySecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedNames"
      ],
      "properties": {
        "allowedNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "maxStagingBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "publicURL": {
          "type": "string"
        },
        "grafanaURL": {
          "type": "string"
        },
        "sessionSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientId": {
              "type": "string"
            },
            "secretRef": {
              "type": "string"
            },
            "clientSecretKey": {
              "type": "string"
            }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?([.][a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?([.][a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                }
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxContexts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "cluster": {
          "type": "string"
        },
        "contextAliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "owner",
              "name",
              "alias"
            ],
            "additionalProperties": false,
            "properties": {
              "owner": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "alias": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_.-]{1,80}$",
                "not": {
                  "const": "__other__"
                }
              }
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*s$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[1-9][0-9]*s$"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "http",
                "https"
              ]
            },
            "sampleLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "tlsConfig": {
              "type": "object"
            },
            "authorization": {
              "type": "object"
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "instanceSelector": {
              "type": "object"
            },
            "folder": {
              "type": "string"
            },
            "datasourceUID": {
              "type": "string"
            },
            "allowCrossNamespaceImport": {
              "type": "boolean"
            },
            "resyncPeriod": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
