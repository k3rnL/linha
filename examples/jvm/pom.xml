<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.linha</groupId>
    <artifactId>linha-jvm</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>linha-examples_2.12</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.linha</groupId>
      <artifactId>linha-client_2.12</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.linha</groupId>
      <artifactId>linha-worker_2.12</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.linha</groupId>
      <artifactId>linha-spark_2.12</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_2.12</artifactId>
      <version>3.5.6</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>cats</pattern>
                  <shadedPattern>linha.shaded.cats</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.circe</pattern>
                  <shadedPattern>linha.shaded.circe</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.typelevel.jawn</pattern>
                  <shadedPattern>linha.shaded.jawn</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>shapeless</pattern>
                  <shadedPattern>linha.shaded.shapeless</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.snakeyaml.engine</pattern>
                  <shadedPattern>linha.shaded.snakeyaml.engine</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
